# Guest image for the Pi agent (pi.dev).
#
# Minimal image: the agent binary + CA certificates. Nothing else from the
# host is baked in; the worktree and the agent config are mounted at launch.
#
# The tag is pinned at build time (see profiles/herdr-pi-kata.json and
# config.toml `image`). Do NOT use :latest in production.

ARG PI_VERSION=latest

FROM node:22-bookworm-slim AS pi
ARG PI_VERSION
# Pi ships via npm; pin the version when building for real use.
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" && \
    npm cache clean --force

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates iptables && \
    rm -rf /var/lib/apt/lists/*
COPY --from=pi /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=pi /usr/local/bin/pi /usr/local/bin/pi
# A non-root user; the entrypoint drops to it after applying the firewall.
RUN useradd -m -s /bin/bash agent
# Egress firewall + entrypoint. No USER directive on purpose: the entrypoint
# starts as root, applies the firewall, then drops to `agent` itself.
COPY guest/egress.sh guest/entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/egress.sh /usr/local/bin/entrypoint.sh
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["pi"]
